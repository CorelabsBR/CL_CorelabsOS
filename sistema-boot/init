#!/bin/sh

export PATH=/sbin:/bin:/usr/sbin:/usr/bin
export HOME=/root

falha() {
    echo "ERRO DE BOOT: $*"
    exec sh
}

# Preparar /proc antes de consultar as montagens.
mkdir -p /proc /sys /dev /dev/pts /nova-raiz

if ! grep -q ' /proc proc ' /proc/mounts 2>/dev/null; then
    mount -t proc proc /proc ||
        falha "não foi possível montar /proc"
fi

if ! grep -q ' /dev devtmpfs ' /proc/mounts; then
    mount -t devtmpfs devtmpfs /dev ||
        falha "não foi possível montar /dev"
fi

if ! grep -q ' /dev/pts devpts ' /proc/mounts; then
    mount -t devpts devpts /dev/pts 2>/dev/null || true
fi

if ! grep -q ' /sys sysfs ' /proc/mounts; then
    mount -t sysfs sysfs /sys ||
        falha "não foi possível montar /sys"
fi

mdev -s

raiz_uuid=""
for argumento in $(cat /proc/cmdline); do
    case "$argumento" in
        root=UUID=*) raiz_uuid="${argumento#root=UUID=}" ;;
    esac
done
[ -n "$raiz_uuid" ] || falha "parâmetro root=UUID ausente"

dispositivo=""
tentativa=0
while [ "$tentativa" -lt 20 ] && [ -z "$dispositivo" ]; do
    for candidato in /dev/vd[a-z][0-9]* /dev/sd[a-z][0-9]*; do
        [ -b "$candidato" ] || continue
        if blkid "$candidato" 2>/dev/null | grep -qi "UUID=\"$raiz_uuid\""; then
            dispositivo="$candidato"
            break
        fi
    done
    [ -n "$dispositivo" ] || sleep 1
    tentativa=$((tentativa + 1))
done

[ -n "$dispositivo" ] || falha "raiz UUID=$raiz_uuid não encontrada"
mount -t ext4 -o rw "$dispositivo" /nova-raiz || falha "não foi possível montar $dispositivo"
[ -x /nova-raiz/init ] || falha "o sistema instalado não contém /init"

echo "Corelabs OS: raiz persistente montada de $dispositivo"
umount /sys /proc
exec switch_root /nova-raiz /init

