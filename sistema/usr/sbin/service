#!/bin/sh

export PATH=/sbin:/bin:/usr/sbin:/usr/bin
diretorio=/etc/corelabs/servicos

[ ! -r /usr/lib/corelabs/registro.sh ] || . /usr/lib/corelabs/registro.sh

registrar() {
    command -v corelabs_registrar >/dev/null 2>&1 || return 0
    corelabs_registrar "SERVICO" "$1" "servicos.log" ||
        echo "[Corelabs] Aviso: falha ao registrar operação." >&2
}

uso() {
    echo "Uso: service <serviço> {start|stop|restart|status}" >&2
    echo "       service --status-all" >&2
    exit 2
}

status_todos() {
    resultado=0
    for servico in "$diretorio"/*; do
        [ -f "$servico" ] || continue
        [ -x "$servico" ] || continue
        case "$servico" in *.disabled) continue ;; esac
        nome="${servico##*/}"
        if "$servico" status >/dev/null 2>&1; then
            echo " [ + ]  $nome"
        else
            echo " [ - ]  $nome"
            resultado=1
        fi
    done
    return "$resultado"
}

if [ "$#" -eq 1 ] && [ "$1" = "--status-all" ]; then
    status_todos
    exit $?
fi

[ "$#" -eq 2 ] || uso
nome="$1"
acao="$2"

case "$acao" in start|stop|restart|status) ;; *) uso ;; esac
case "$nome" in
    ''|*[!a-zA-Z0-9_.-]*|.|..|*.disabled)
        echo "service: nome de serviço inválido: $nome" >&2
        exit 2
        ;;
esac

servico="$diretorio/$nome"
[ -f "$servico" ] && [ -x "$servico" ] || {
    echo "service: serviço não encontrado: $nome" >&2
    exit 1
}

registrar "Solicitado: $acao $nome"
case "$acao" in
    restart)
        "$servico" stop
        resultado=$?
        if [ "$resultado" -eq 0 ]; then
            "$servico" start
            resultado=$?
        fi
        ;;
    *) "$servico" "$acao"; resultado=$? ;;
esac

if [ "$resultado" -eq 0 ]; then
    registrar "Concluído: $acao $nome"
    exit 0
fi
registrar "Falha: $acao $nome (código $resultado)"
exit "$resultado"
