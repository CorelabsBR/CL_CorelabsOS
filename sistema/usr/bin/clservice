#!/bin/sh

uso() {
    echo "Uso: clservice {start|stop|restart|status|list} [serviço]" >&2
    exit 2
}

[ "$#" -ge 1 ] || uso
acao="$1"
case "$acao" in
    list)
        [ "$#" -eq 1 ] || uso
        for servico in /etc/corelabs/servicos/*; do
            [ -f "$servico" ] || continue
            [ -x "$servico" ] || continue
            case "$servico" in *.disabled) continue ;; esac
            echo "${servico##*/}"
        done
        ;;
    start|stop|restart|status)
        [ "$#" -eq 2 ] || uso
        exec /usr/sbin/service "$2" "$acao"
        ;;
    *) uso ;;
esac
